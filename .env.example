# Local development configuration. Copy to .env and fill in. Never commit .env.
#
# This is the LOCAL file: dev login is on, the database password is a placeholder and the
# signing key is not real. Do not copy it to a server — deploying uses its own standalone
# file, `.env.production.example`. See docs/deployment.md.

APP_ENV=local
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000
# The web app's non-default locale prefixes, comma-separated, mirroring its i18n config.
# Sign-in returns the visitor to WEB_URL/<prefix> when they picked one; anything outside
# this list is ignored, which is what keeps the return destination un-forgeable.
WEB_LOCALE_PREFIXES=zh-TW

DATABASE_URL=postgresql+asyncpg://sightread:sightread@pg:5432/sightread
POSTGRES_USER=sightread
POSTGRES_PASSWORD=sightread
POSTGRES_DB=sightread
# Host port the local compose stack publishes PostgreSQL on; change it when 5432 is
# already in use on this machine (the container still listens on 5432 internally).
PG_PORT=5432

# Long random string; sessions + HKDF root for the stored upstream keys (Kano Proxy keys
# and provider connection keys).
SECRET_KEY=<generate-a-long-random-string>

# Google OIDC (required in production; optional locally with AUTH_DEV_MODE)
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Kano Proxy, the only upstream (docs/auth.md § 3). The origin, no path, and the
# operator's own key, presented on every upstream call. Either empty = no upstream: parse
# and chat refuse with 503.
KANO_PROXY_BASE_URL=https://kano-proxy.example.com
KANO_PROXY_API_KEY=<kano-proxy-api-key>

# Local only — enables /api/auth/dev-login. Ignored unless APP_ENV=local.
AUTH_DEV_MODE=true

# The subscription (docs/billing.md).
# The parse pipeline's models (CHECK_MODEL empty = the parse model; PARSE_FALLBACK_MODEL
# empty = no fallback) and the chat models offered, comma-separated, the first the default.
PARSE_MODEL=
CHECK_MODEL=
PARSE_FALLBACK_MODEL=
# List prices, USD per 1M tokens, for every model named above; the server refuses to start
# with one missing here. The chat agent offers the Kano Proxy catalog's models priced here,
# in this order, the first the default.
MODEL_PRICES_JSON={}
# What one credit is worth in list-price USD, credits per parsed page, and the balance a
# chat send needs.
CREDIT_USD=0.002
PARSE_CREDITS_PER_PAGE=1
CHAT_MIN_CREDITS=1
# The Free plan: credits per UTC month, storage (must not exceed WORKSPACE_QUOTA_BYTES) and
# parses at once (must not exceed MAX_JOBS_PER_USER).
FREE_CREDITS_PER_PERIOD=150
FREE_STORAGE_BYTES=512000000
FREE_MAX_JOBS=1
# What the public Terms, Privacy and Refund pages print (docs/web.md § Pages): the address
# for questions, deletion and refund requests, and who operates the service. Either empty =
# that line is not printed.
SUPPORT_EMAIL=
OPERATOR_NAME=
# Kano Pay (docs/billing.md § Kano Pay): all four set = configured; otherwise every user
# is on Free and checkout is unavailable. The key and the secret are secrets.
KANO_PAY_URL=
KANO_PAY_APP_ID=
KANO_PAY_API_KEY=
KANO_PAY_WEBHOOK_SECRET=
# What a paid plan grants; its price is Pay's. Each entry's storageBytes and maxJobs must
# fit the ceilings above.
KANO_PAY_PLANS_JSON=[]
# What a top-up pack grants and how long it is valid, Pro only; its price is Pay's
# (docs/billing.md § Top-up packs). Empty = no pack is sold.
KANO_PAY_PACKS_JSON=[]
# How often GET /api/billing may reconcile with Pay per user (seconds).
BILLING_REFRESH_SECONDS=120
# Each call to Pay (seconds), the replay window of a notification's timestamp (seconds),
# how long one catalog answer is served (seconds), the most a notification may carry.
KANO_PAY_TIMEOUT_SECONDS=15
KANO_PAY_SIGNATURE_TOLERANCE_SECONDS=300
KANO_PAY_CATALOG_TTL_SECONDS=300
KANO_PAY_EVENT_MAX_BYTES=65536
# How long a checkout Pay opened can still be paid (seconds): an account with one that
# young is not deleted.
KANO_PAY_CHECKOUT_LIFETIME_SECONDS=86400

# Limits (defaults shown; see docs/api.md, docs/jobs.md)
UPLOAD_MAX_BYTES=134217728
# The most a file of any other kind may be on the Files page (docs/workspace.md § Files).
FILE_MAX_BYTES=2000000000
PAGE_CAP=500
MAX_JOBS_PER_USER=2
# The Retry-After (seconds) a parse refused by that cap tells the client.
PARSE_RETRY_AFTER_SECONDS=30
# A library upload retried within this many seconds of its first request's job finishing
# is answered with that job, never a second parse.
UPLOAD_RETRY_WINDOW_SECONDS=60
VISION_CONCURRENCY_PER_JOB=8
# The tokens one vision call's answer may take, transcription or figure check; 0 sends no
# cap (docs/parsing.md § Upstream usage).
VISION_MAX_OUTPUT_TOKENS=16000
# RENDER_WORKERS defaults to CPU count
UPLOAD_DIR=/data/uploads
# How old an upload-directory entry may grow before the worker's sweeper takes it, an
# unsent chat attachment's included (docs/jobs.md § Retention).
UPLOAD_MAX_AGE_SECONDS=86400
# How many days a finished parse no file names is kept before the worker's sweep deletes
# it with its result, crops and workspace copy; 0 keeps every one (docs/jobs.md
# § Retention).
PARSE_RETENTION_DAYS=30
# Stored figure crops — kept with results, outside UPLOAD_DIR so the sweeper never
# touches them (docs/parsing.md § Figure crops)
FIGURES_DIR=/data/figures
# Cap on stored crops per page (docs/parsing.md § Figure crops)
FIGURES_PER_PAGE_MAX=40
# Model rounds one page's figure check may take, one call each; at least 1
# (docs/parsing.md § Figure check)
FIGURE_CHECK_ROUNDS=2
SYSTEM_PROMPT_MAX_CHARS=8000
UPSTREAM_RESPONSE_MAX_BYTES=33554432
# The chat agent's event stream: the most one SSE line may hold, and the most content
# blocks one answer may hold.
UPSTREAM_SSE_LINE_MAX_BYTES=4194304
UPSTREAM_CONTENT_BLOCKS_MAX=4096
# Single-use upload tickets minted by the MCP `parse` tool (see docs/auth.md § 5)
UPLOAD_TICKET_TTL_SECONDS=3600
UPLOAD_TICKET_RATE_PER_HOUR=30

# Per-user workspaces (docs/workspace.md): a host directory bind-mounted at the same path
# into api, worker and sandbox, so the runner can hand it to `docker run` unchanged.
# Host side of that directory, bind-mounted into api, worker and sandbox by compose.
# Empty: compose mounts ./workspaces and hands the runner ${PWD}/workspaces. To use
# another directory, set an absolute path: the runner hands this same path to
# `docker run`, which resolves nothing relative to the compose project, and refuses to
# start with a relative one.
WORKSPACES_HOST_DIR=
WORKSPACES_DIR=/data/workspaces
WORKSPACE_QUOTA_BYTES=10737418240
# How long a backup pass waits for unconfirmed shell commands (.repos/<user>.writing)
# to clear before archiving regardless and naming them in the stamp. Read by the
# production backup service only.
BACKUP_WRITING_WAIT_SECONDS=3600
# The largest doc.md / notes.md the API will open (the shell can write anything).
CONTENT_MAX_BYTES=8388608
# The largest file a revision records; a larger or a binary one is kept in the tree but
# not in history (docs/workspace.md § Revisions).
REVISION_MAX_FILE_BYTES=1048576
# An image inserted into a document: the upload's cap and the long edge it is kept at.
DOCUMENT_IMAGE_MAX_BYTES=20971520
DOCUMENT_IMAGE_LONG_EDGE=2400
# A page of an original shown in the retry dialog: its long edge, and how many the API
# makes at once (docs/api.md § Limits).
PAGE_PREVIEW_LONG_EDGE=1200
PAGE_PREVIEW_RENDERS=2
# The format check of a Files upload: spots sent to the check agent, calls one check may
# make, and the tokens of one answer (docs/parsing.md § Format check).
CHECK_SPOTS_MAX=80
CHECK_MAX_CALLS=16
CHECK_MAX_OUTPUT_TOKENS=16000

# The chat agent (docs/chat.md)
MAX_CHAT_TURNS_PER_USER=4
# The Retry-After (seconds) a send refused by that cap tells the client.
CHAT_RETRY_AFTER_SECONDS=15
CHAT_MAX_OUTPUT_TOKENS=64000
# High enough that a document translated block by block is one turn.
CHAT_MAX_TOOL_CALLS_PER_TURN=1000
# Tool calls a turn may still make once the credits run out mid-turn; then it answers.
CHAT_OVERDRAFT_MAX_TOOL_CALLS=25
CHAT_TURN_TIMEOUT_SECONDS=3600
# A model stream silent for this long ends the turn rather than being retried.
CHAT_STREAM_TIMEOUT_SECONDS=900
# Past the command timeout, how long a turn at its deadline waits for the write in flight.
CHAT_WRITER_GRACE_SECONDS=60
# The most restored content a single revert may hold in memory.
REVERT_MAX_BYTES=67108864
# The most paths a single revert may touch.
REVERT_MAX_PATHS=2000
# The most of a git log the API reads to list revisions, and the paths it keeps per
# revision.
WORKSPACE_LOG_MAX_BYTES=4194304
WORKSPACE_LOG_FILES_MAX=200
# How long any one git call the host makes may take.
WORKSPACE_GIT_TIMEOUT_SECONDS=60
# How many loose objects a workspace's history may hold before the worker packs it.
WORKSPACE_GIT_PACK_LOOSE_OBJECTS=100
# How many days an item stays in the Trash before the worker's sweep deletes it for good;
# 0 = the Trash is emptied by the reader alone (docs/workspace.md § The Trash).
TRASH_RETENTION_DAYS=30
CHAT_TOOL_RESULT_MAX_CHARS=20000
# The longest message and selection a send may carry.
CHAT_MESSAGE_MAX_CHARS=32000
CHAT_SELECTION_MAX_CHARS=16000
# A shell command is killed after this many seconds (SANDBOX_COMMAND_TIMEOUT_MAX caps it).
CHAT_BASH_TIMEOUT_SECONDS=120
# Encoded image bytes one round of view_page / view_figure calls may return in all.
CHAT_IMAGE_ROUND_MAX_BYTES=33554432
# Encoded image bytes a whole turn may return, every round together.
CHAT_IMAGE_TURN_MAX_BYTES=134217728
# The most pixels an image document may decode to when view_page renders it (read from
# the file's header, before anything is decoded).
CHAT_PAGE_IMAGE_MAX_PIXELS=40000000
# The stored history a conversation may replay, every message together; a turn past it
# is refused with a pointer to a new conversation.
CHAT_HISTORY_MAX_BYTES=268435456
# The composer's attachments: one file's upload cap, how many one message carries, how
# much of a PDF's or text file's text the model is given, and the long edge an attached
# image is kept at.
CHAT_ATTACHMENT_MAX_BYTES=20971520
CHAT_ATTACHMENTS_PER_MESSAGE=8
CHAT_ATTACHMENT_TEXT_MAX_CHARS=100000
CHAT_ATTACHMENT_IMAGE_LONG_EDGE=1568
# How many of a user's attachments may wait for their message at once, and how long the
# browser may cache an attached image (a stored message never changes).
CHAT_ATTACHMENTS_PENDING_MAX=32
CHAT_ATTACHMENT_CACHE_SECONDS=31536000
# How long pdftotext may take on an attached PDF.
CHAT_ATTACHMENT_PDF_TIMEOUT_SECONDS=60
# How many skills and subagents of their own a user may keep, and the tool calls one
# subagent run may make.
CHAT_SKILLS_MAX=64
CHAT_SUBAGENTS_MAX=32
CHAT_SUBAGENT_MAX_TOOL_CALLS=1000
# The reader's instructions for the chat agent, appended after its prompt.
CHAT_INSTRUCTIONS_MAX_CHARS=8000
# The agent's memories of the reader: one memory's text, how many a reader keeps, and how
# much of them one conversation loads.
CHAT_MEMORY_MAX_CHARS=500
CHAT_MEMORIES_MAX=200
CHAT_MEMORY_BLOCK_MAX_CHARS=12000
# Whole sections one message may carry (each capped like the selection), and the longest
# heading one may have.
CHAT_SECTIONS_PER_MESSAGE=4
CHAT_SECTION_HEADING_MAX_CHARS=512

# The chat agent's web tools (docs/chat.md § Tools), run on the worker, never in the VM.
# CHAT_WEB_ACCESS=false takes all four away. web_search needs a Brave Search API key
# (https://api-dashboard.search.brave.com; the tool is absent without one) and costs the
# reader WEB_SEARCH_CREDITS per answered call on top of the turn's tokens; search_papers
# needs an OpenAlex key (https://openalex.org/settings/api; absent without one) and is free.
CHAT_WEB_ACCESS=true
BRAVE_SEARCH_API_KEY=
OPENALEX_API_KEY=
# The endpoints the two searches call; a deployment may point them at a mirror of its own.
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
OPENALEX_WORKS_URL=https://api.openalex.org/works
WEB_SEARCH_CREDITS=3
# Caps: per turn, and per UTC day — the two searches for the whole deployment (the
# operator's bill and OpenAlex budget), downloads per user.
WEB_SEARCH_MAX_PER_TURN=10
WEB_SEARCH_MAX_PER_DAY=2000
PAPER_SEARCH_MAX_PER_TURN=10
PAPER_SEARCH_MAX_PER_DAY=1000
READ_URL_MAX_PER_TURN=30
DOWNLOAD_MAX_PER_DAY=20
# How much of a page read_url reads, the largest download (FILE_MAX_BYTES caps it too),
# and how long a search or read, and a download, may take.
READ_URL_MAX_BYTES=5242880
DOWNLOAD_MAX_BYTES=100000000
WEB_TOOL_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120

# The sandbox runner (docs/sandbox.md). Empty SANDBOX_URL = no sandbox: the chat agent
# runs without its bash tool. The token is shared between api, worker and the runner.
# The port the runner listens on; the compose file derives SANDBOX_URL from it for api and
# worker when SANDBOX_URL is left unset here (an empty SANDBOX_URL= still disables the
# sandbox), and the runner's health check probes it.
SANDBOX_PORT=8100
SANDBOX_URL=http://sandbox:8100
SANDBOX_TOKEN=<generate-a-long-random-string>
# How long api and worker give the runner's stop, reset, restart and status calls; must
# cover SANDBOX_DOCKER_TIMEOUT_SECONDS plus the inspection after it and a reset's deletion.
SANDBOX_CONTROL_TIMEOUT_SECONDS=180
# What a command may take beyond its own timeout: the VM's cold start (the runner gives
# `docker run` this long too) and the grace for the reply past the command's deadline.
SANDBOX_START_TIMEOUT_SECONDS=180
SANDBOX_EXEC_GRACE_SECONDS=60
# Read by the runner container (SANDBOX_NETWORK by the worker too). `kata` needs /dev/kvm and the Kata runtime registered
# with Docker; `runc` is for local development and is refused in production.
SANDBOX_RUNTIME=runc
# The runtime names production accepts: VM runtimes only (docs/sandbox.md § Isolation).
SANDBOX_VM_RUNTIMES=kata,kata-runtime,io.containerd.kata.v2,kata-qemu,kata-clh,kata-fc
SANDBOX_IMAGE=sightread-sandbox
# `none`, or the name of an internal network holding a PyPI-only proxy. Both read by
# the worker too: the chat agent's prompt promises `uv add` only with a network and
# an index URL.
SANDBOX_NETWORK=none
SANDBOX_INDEX_URL=
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_PIDS=512
# The VM's writable scratch space at /tmp (a tmpfs, counted against SANDBOX_MEMORY).
SANDBOX_TMP_SIZE=1g
SANDBOX_IDLE_SECONDS=1200
# The longest any one command may run, whatever the api asks for (CHAT_BASH_TIMEOUT_SECONDS).
SANDBOX_COMMAND_TIMEOUT_MAX=600
# How long the runner gives Docker to remove a VM on stop.
SANDBOX_DOCKER_TIMEOUT_SECONDS=120
# Shells one user's VM keeps open at once; the longest idle one is closed for a new one.
SANDBOX_MAX_SHELLS=8
SANDBOX_OUTPUT_MAX_BYTES=262144
# The longest command (characters) the runner accepts; a longer one answers 422, which
# the bash tool reports to the model.
SANDBOX_COMMAND_MAX_CHARS=65536
# Where compose mounts WORKSPACES_HOST_DIR inside the runner container.
SANDBOX_WORKSPACES_MOUNT=/data/workspaces
# Absolute host path of the workspaces as the Docker daemon sees them; empty lets the
# local compose file derive it from WORKSPACES_HOST_DIR, or ${PWD}/workspaces.
SANDBOX_WORKSPACES_DIR=
