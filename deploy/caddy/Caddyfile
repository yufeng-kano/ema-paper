# Production routing and TLS (docs/deployment.md). DOMAIN and ACME_EMAIL come from the
# environment of the caddy service in docker-compose.production.yaml.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Validate over the 443 we already own. Port 80 is not published in every deployment
	# (docker-compose.only-container-network.yaml), so HTTP-01 cannot be relied on; TLS-ALPN-01
	# (RFC 8737) rides the same connection the site is served on.
	tls {
		issuer acme {
			email {$ACME_EMAIL}
			disable_http_challenge
		}
	}

	# Security headers on every answer, the API's and the web app's alike (docs/deployment.md
	# § Security headers, which explains each CSP source). Deferred, so each value replaces
	# whatever the upstream sent. Caddyfile.local carries the same blocks without HSTS.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
	# The policy and the frame header on every answer but the file route's, which carries
	# its own (docs/api.md § GET /api/library/documents/{id}/file): a file served from the
	# tree runs nothing with the session, and the site's policy would replace that.
	@notfile not path /api/library/documents/*/file
	header @notfile {
		defer
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		X-Frame-Options DENY
	}

	# Body caps per route (docs/deployment.md § Caddy routing). The web upload carries a
	# file of any kind: FILE_MAX_BYTES plus the multipart envelope. Everything else keeps
	# UPLOAD_MAX_BYTES. Keep both in sync with .env: the app enforces the same caps while
	# streaming, these stop an oversized body before it reaches Python.
	@upload path /api/library/documents
	request_body @upload {
		max_size 2048MB
	}
	@rest not path /api/library/documents
	request_body @rest {
		max_size 128MB
	}

	# Everything the FastAPI app owns: the data plane, the control plane, the OAuth
	# authorization server, its discovery documents, and the MCP endpoint. The ACME
	# challenge also lives under /.well-known/, but Caddy answers that itself on :80
	# before any route here is consulted.
	@api path /healthz /v1/* /api/* /oauth/* /mcp /mcp/* /.well-known/*
	handle @api {
		reverse_proxy api:8000 {
			# Uploads and SSE go straight through: no response buffering, and long idle
			# gaps are normal on a progress stream (keepalives are 10 s apart).
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
				dial_timeout 10s
			}
		}
	}

	# Everything else is the Nuxt app.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
	}
}
