# Local single-origin entry point (docs/deployment.md): mirrors the production routing
# so the built web image can reach the API on the same origin. Plain HTTP, no TLS.
http://localhost:8080 {
	# The production security headers minus HSTS, which a browser ignores over plain HTTP,
	# so a CSP violation shows up here first (docs/deployment.md § Security headers).
	header {
		defer
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
	@notfile not path /api/library/documents/*/file /api/library/documents/*/original
	header @notfile {
		defer
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		X-Frame-Options DENY
	}

	@upload path /api/library/documents
	request_body @upload {
		max_size 2048MB
	}
	@rest not path /api/library/documents
	request_body @rest {
		max_size 128MB
	}

	@api path /healthz /v1/* /api/* /oauth/* /mcp /mcp/* /.well-known/*
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
